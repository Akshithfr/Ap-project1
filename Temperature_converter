
def celsius_to_fahrenheit(celsius):
    return (celsius * 9 / 5) + 32


def fahrenheit_to_celsius(fahrenheit):
    return (fahrenheit - 32) * 5 / 9


def convert_temperature(temperature, choice):
    if choice == "1":
        return celsius_to_fahrenheit(temperature)
    else:
        return fahrenheit_to_celsius(temperature)


def main():
    print("=== Temperature Converter ===")
    print("1. Celsius to Fahrenheit")
    print("2. Fahrenheit to Celsius")

    choice = input("Enter your choice: ")

    if choice not in ("1", "2"):
        print("Error: Invalid conversion choice.")
        return

    try:
        temperature = float(
            input("Enter temperature: ").replace(",", ".")
        )
    except ValueError:
        print("Error: Please enter a valid number.")
        return

    if choice == "1":
        if temperature < -273.15:
            print("Error: Temperature is below absolute zero.")
            return

        result = convert_temperature(temperature, choice)
        print(f"Result: {temperature:.2f}°C = {result:.2f}°F")

    else:
        if temperature < -459.67:
            print("Error: Temperature is below absolute zero.")
            return

        result = convert_temperature(temperature, choice)
        print(f"Result: {temperature:.2f}°F = {result:.2f}°C")


if __name__ == "__main__":
    main()
